<xml xmlns="http://www.w3.org/1999/xhtml" is_dbot="true" collection="false">
 <variables>
  <variable id="var_stake">Stake</variable>
  <variable id="var_martingale">Martingale</variable>
  <variable id="var_take_profit">Take_Profit</variable>
  <variable id="var_max_loss">Max_Consecutive_Loss</variable>
  <variable id="var_current_stake">Current_Stake</variable>
  <variable id="var_loss_count">Consecutive_Loss_Count</variable>
  <variable id="var_next_trade">Next_Trade</variable>
 </variables>
 <block type="trade_definition" id="blk059" deletable="false" x="0" y="0">
  <statement name="INITIALIZATION">
   <block type="variables_set" id="blk014">
    <field name="VAR" id="var_stake" variabletype="">Stake</field>
    <value name="VALUE"><block type="math_number" id="blk013"><field name="NUM">0.35</field></block></value>
    <next><block type="variables_set" id="blk012">
     <field name="VAR" id="var_martingale" variabletype="">Martingale</field>
     <value name="VALUE"><block type="math_number" id="blk011"><field name="NUM">2.1</field></block></value>
     <next><block type="variables_set" id="blk010">
      <field name="VAR" id="var_take_profit" variabletype="">Take_Profit</field>
      <value name="VALUE"><block type="math_number" id="blk009"><field name="NUM">5</field></block></value>
      <next><block type="variables_set" id="blk008">
       <field name="VAR" id="var_max_loss" variabletype="">Max_Consecutive_Loss</field>
       <value name="VALUE"><block type="math_number" id="blk007"><field name="NUM">5</field></block></value>
       <next><block type="variables_set" id="blk006">
        <field name="VAR" id="var_current_stake" variabletype="">Current_Stake</field>
        <value name="VALUE"><block type="variables_get" id="blk005"><field name="VAR" id="var_stake" variabletype="">Stake</field></block></value>
        <next><block type="variables_set" id="blk004">
         <field name="VAR" id="var_loss_count" variabletype="">Consecutive_Loss_Count</field>
         <value name="VALUE"><block type="math_number" id="blk003"><field name="NUM">0</field></block></value>
         <next><block type="variables_set" id="blk002">
          <field name="VAR" id="var_next_trade" variabletype="">Next_Trade</field>
          <value name="VALUE"><block type="text" id="blk001"><field name="TEXT">ODD</field></block></value>
         </block></next>
        </block></next>
       </block></next>
      </block></next>
     </block></next>
    </block></next>
   </block>
  </statement>
  <statement name="SUBMARKET">
   <block type="trade_definition_tradeoptions" id="blk021">
    <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="false"/>
    <field name="DURATIONTYPE_LIST">t</field><field name="CURRENCY_LIST">USD</field>
    <value name="DURATION"><block type="math_number" id="blk022"><field name="NUM">1</field></block></value>
    <value name="AMOUNT"><block type="variables_get" id="blk023"><field name="VAR" id="var_current_stake" variabletype="">Current_Stake</field></block></value>
   </block>
  </statement>
  <statement name="TRADE_OPTIONS">
   <block type="trade_definition_market" id="blk020" deletable="false" movable="false">
    <field name="MARKET_LIST">synthetic_index</field><field name="SUBMARKET_LIST">random_index</field><field name="SYMBOL_LIST">1HZ100V</field>
    <next><block type="trade_definition_tradetype" id="blk019" deletable="false" movable="false">
     <field name="TRADETYPECAT_LIST">digits</field><field name="TRADETYPE_LIST">evenodd</field>
     <next><block type="trade_definition_contracttype" id="blk018" deletable="false" movable="false">
      <field name="TYPE_LIST">both</field>
      <next><block type="trade_definition_candleinterval" id="blk017" deletable="false" movable="false">
       <field name="CANDLEINTERVAL_LIST">60</field>
       <next><block type="trade_definition_restartbuysell" id="blk016" deletable="false" movable="false">
        <field name="TIME_MACHINE_ENABLED">FALSE</field>
        <next><block type="trade_definition_restartonerror" id="blk015" deletable="false" movable="false"><field name="RESTARTONERROR">TRUE</field></block></next>
       </block></next>
      </block></next>
     </block></next>
    </block></next>
   </block>
  </statement>
 </block>
 <block type="before_purchase" id="blk060" deletable="false" x="0" y="1000">
  <statement name="BEFOREPURCHASE_STACK">
   <block type="controls_if" id="blk033">
    <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"/>
    <value name="IF0"><block type="logic_compare" id="blk026">
     <field name="OP">EQ</field>
     <value name="A"><block type="variables_get" id="blk024"><field name="VAR" id="var_next_trade" variabletype="">Next_Trade</field></block></value>
     <value name="B"><block type="text" id="blk025"><field name="TEXT">ODD</field></block></value>
    </block></value>
    <statement name="DO0">
     <block type="variables_set" id="blk029">
      <field name="VAR" id="var_next_trade" variabletype="">Next_Trade</field>
      <value name="VALUE"><block type="text" id="blk027"><field name="TEXT">EVEN</field></block></value>
      <next><block type="purchase" id="blk028"><field name="PURCHASE_LIST">DIGITODD</field></block></next>
     </block>
    </statement>
    <statement name="ELSE">
     <block type="variables_set" id="blk032">
      <field name="VAR" id="var_next_trade" variabletype="">Next_Trade</field>
      <value name="VALUE"><block type="text" id="blk030"><field name="TEXT">ODD</field></block></value>
      <next><block type="purchase" id="blk031"><field name="PURCHASE_LIST">DIGITEVEN</field></block></next>
     </block>
    </statement>
   </block>
  </statement>
 </block>
 <block type="during_purchase" id="blk061" deletable="false" x="0" y="1500"/>
 <block type="after_purchase" id="blk062" deletable="false" x="800" y="0">
  <statement name="AFTERPURCHASE_STACK">
   <block type="controls_if" id="blk058">
    <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"/>
    <value name="IF0"><block type="contract_check_result" id="blk057"><field name="CHECK_RESULT">win</field></block></value>
    <statement name="DO0">
     <block type="variables_set" id="blk037">
      <field name="VAR" id="var_current_stake" variabletype="">Current_Stake</field>
      <value name="VALUE"><block type="variables_get" id="blk034"><field name="VAR" id="var_stake" variabletype="">Stake</field></block></value>
      <next><block type="variables_set" id="blk036">
       <field name="VAR" id="var_loss_count" variabletype="">Consecutive_Loss_Count</field>
       <value name="VALUE"><block type="math_number" id="blk035"><field name="NUM">0</field></block></value>
      </block></next>
     </block>
    </statement>
    <statement name="ELSE">
     <block type="math_change" id="blk038">
      <field name="VAR" id="var_loss_count" variabletype="">Consecutive_Loss_Count</field>
      <value name="DELTA"><block type="math_number" id="blk039"><field name="NUM">1</field></block></value>
      <next><block type="controls_if" id="blk051">
       <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"/>
       <value name="IF0"><block type="logic_compare" id="blk042">
        <field name="OP">GTE</field>
        <value name="A"><block type="variables_get" id="blk040"><field name="VAR" id="var_loss_count" variabletype="">Consecutive_Loss_Count</field></block></value>
        <value name="B"><block type="variables_get" id="blk041"><field name="VAR" id="var_max_loss" variabletype="">Max_Consecutive_Loss</field></block></value>
       </block></value>
       <statement name="DO0">
        <block type="variables_set" id="blk046">
         <field name="VAR" id="var_current_stake" variabletype="">Current_Stake</field>
         <value name="VALUE"><block type="variables_get" id="blk043"><field name="VAR" id="var_stake" variabletype="">Stake</field></block></value>
         <next><block type="variables_set" id="blk045">
          <field name="VAR" id="var_loss_count" variabletype="">Consecutive_Loss_Count</field>
          <value name="VALUE"><block type="math_number" id="blk044"><field name="NUM">0</field></block></value>
         </block></next>
        </block>
       </statement>
       <statement name="ELSE">
        <block type="variables_set" id="blk050">
         <field name="VAR" id="var_current_stake" variabletype="">Current_Stake</field>
         <value name="VALUE"><block type="math_arithmetic" id="blk049">
          <field name="OP">MULTIPLY</field>
          <value name="A"><block type="variables_get" id="blk047"><field name="VAR" id="var_current_stake" variabletype="">Current_Stake</field></block></value>
          <value name="B"><block type="variables_get" id="var_martingale" variabletype="">Martingale</field></block></value>
         </block></value>
        </block>
       </statement>
      </block></next>
     </block>
    </statement>
    <next><block type="controls_if" id="blk056">
     <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"/>
     <value name="IF0"><block type="logic_compare" id="blk054">
      <field name="OP">GTE</field>
      <value name="A"><block type="total_profit" id="blk052"/></value>
      <value name="B"><block type="variables_get" id="blk053"><field name="VAR" id="var_take_profit" variabletype="">Take_Profit</field></block></value>
     </block></value>
     <statement name="ELSE"><block type="trade_again" id="blk055"/></statement>
    </block></next>
   </block>
  </statement>
 </block>
</xml>