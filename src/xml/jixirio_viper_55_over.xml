<xml xmlns="http://www.w3.org/1999/xhtml" is_dbot="true" collection="false">
 <variables>
  <variable id="var_initial_stake">Initial_Stake</variable>
  <variable id="var_current_stake">Current_Stake</variable>
  <variable id="var_mart_mult">Martingale_Multiplier</variable>
  <variable id="var_loss_count">Loss_Count</variable>
  <variable id="var_max_steps">Max_Recovery_Steps</variable>
  <variable id="var_take_profit">Take_Profit</variable>
  <variable id="var_stop_loss">Stop_Loss</variable>
 </variables>
 <block type="trade_definition" id="blk069" deletable="false" x="0" y="0">
  <statement name="INITIALIZATION">
   <block type="variables_set" id="blk014">
    <field name="VAR" id="var_initial_stake" variabletype="">Initial_Stake</field>
    <value name="VALUE"><block type="math_number" id="blk013"><field name="NUM">0.35</field></block></value>
    <next><block type="variables_set" id="blk012">
     <field name="VAR" id="var_current_stake" variabletype="">Current_Stake</field>
     <value name="VALUE"><block type="math_number" id="blk011"><field name="NUM">0.35</field></block></value>
     <next><block type="variables_set" id="blk010">
      <field name="VAR" id="var_mart_mult" variabletype="">Martingale_Multiplier</field>
      <value name="VALUE"><block type="math_number" id="blk009"><field name="NUM">5.5</field></block></value>
      <next><block type="variables_set" id="blk008">
       <field name="VAR" id="var_loss_count" variabletype="">Loss_Count</field>
       <value name="VALUE"><block type="math_number" id="blk007"><field name="NUM">0</field></block></value>
       <next><block type="variables_set" id="blk006">
        <field name="VAR" id="var_max_steps" variabletype="">Max_Recovery_Steps</field>
        <value name="VALUE"><block type="math_number" id="blk005"><field name="NUM">3</field></block></value>
        <next><block type="variables_set" id="blk004">
         <field name="VAR" id="var_take_profit" variabletype="">Take_Profit</field>
         <value name="VALUE"><block type="math_number" id="blk003"><field name="NUM">5</field></block></value>
         <next><block type="variables_set" id="blk002">
          <field name="VAR" id="var_stop_loss" variabletype="">Stop_Loss</field>
          <value name="VALUE"><block type="math_number" id="blk001"><field name="NUM">15</field></block></value>
         </block></next>
        </block></next>
       </block></next>
      </block></next>
     </block></next>
    </block></next>
   </block>
  </statement>
  <statement name="SUBMARKET">
   <block type="trade_definition_tradeoptions" id="blk021">
    <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="true"/>
    <field name="DURATIONTYPE_LIST">t</field><field name="CURRENCY_LIST">USD</field>
    <value name="DURATION"><block type="math_number" id="blk022"><field name="NUM">1</field></block></value>
    <value name="AMOUNT"><block type="variables_get" id="blk023"><field name="VAR" id="var_current_stake" variabletype="">Current_Stake</field></block></value>
    <value name="PREDICTION"><block type="math_number" id="blk024"><field name="NUM">1</field></block></value>
   </block>
  </statement>
  <statement name="TRADE_OPTIONS">
   <block type="trade_definition_market" id="blk020" deletable="false" movable="false">
    <field name="MARKET_LIST">synthetic_index</field><field name="SUBMARKET_LIST">random_index</field><field name="SYMBOL_LIST">1HZ100V</field>
    <next><block type="trade_definition_tradetype" id="blk019" deletable="false" movable="false">
     <field name="TRADETYPECAT_LIST">digits</field><field name="TRADETYPE_LIST">overunder</field>
     <next><block type="trade_definition_contracttype" id="blk018" deletable="false" movable="false">
      <field name="TYPE_LIST">DIGITOVER</field>
      <next><block type="trade_definition_candleinterval" id="blk017" deletable="false" movable="false">
       <field name="CANDLEINTERVAL_LIST">60</field>
       <next><block type="trade_definition_restartbuysell" id="blk016" deletable="false" movable="false">
        <field name="TIME_MACHINE_ENABLED">FALSE</field>
        <next><block type="trade_definition_restartonerror" id="blk015" deletable="false" movable="false"><field name="RESTARTONERROR">TRUE</field></block></next>
       </block></next>
      </block></next>
     </block></next>
    </block></next>
   </block>
  </statement>
 </block>
 <block type="before_purchase" id="blk070" deletable="false" x="0" y="1000">
  <statement name="BEFOREPURCHASE_STACK">
   <block type="controls_if" id="blk037">
    <value name="IF0"><block type="logic_operation" id="blk035">
     <field name="OP">AND</field>
     <value name="A"><block type="logic_compare" id="blk029">
      <field name="OP">LTE</field>
      <value name="A"><block type="lists_getIndex" id="blk025">
       <mutation xmlns="http://www.w3.org/1999/xhtml" statement="false" at="true"/>
       <field name="MODE">GET</field><field name="WHERE">FROM_END</field>
       <value name="VALUE"><block type="lastDigitList" id="blk026"/></value>
       <value name="AT"><block type="math_number" id="blk027"><field name="NUM">1</field></block></value>
      </block></value>
      <value name="B"><block type="math_number" id="blk028"><field name="NUM">1</field></block></value>
     </block></value>
     <value name="B"><block type="logic_compare" id="blk034">
      <field name="OP">LTE</field>
      <value name="A"><block type="lists_getIndex" id="blk030">
       <mutation xmlns="http://www.w3.org/1999/xhtml" statement="false" at="true"/>
       <field name="MODE">GET</field><field name="WHERE">FROM_END</field>
       <value name="VALUE"><block type="lastDigitList" id="blk031"/></value>
       <value name="AT"><block type="math_number" id="blk032"><field name="NUM">2</field></block></value>
      </block></value>
      <value name="B"><block type="math_number" id="blk033"><field name="NUM">1</field></block></value>
     </block></value>
    </block></value>
    <statement name="DO0"><block type="purchase" id="blk036"><field name="PURCHASE_LIST">DIGITOVER</field></block></statement>
   </block>
  </statement>
 </block>
 <block type="during_purchase" id="blk071" deletable="false" x="0" y="1500"/>
 <block type="after_purchase" id="blk072" deletable="false" x="800" y="0">
  <statement name="AFTERPURCHASE_STACK">
   <block type="controls_if" id="blk068">
    <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"/>
    <value name="IF0"><block type="contract_check_result" id="blk067"><field name="CHECK_RESULT">win</field></block></value>
    <statement name="DO0">
     <block type="variables_set" id="blk041">
      <field name="VAR" id="var_current_stake" variabletype="">Current_Stake</field>
      <value name="VALUE"><block type="variables_get" id="blk038"><field name="VAR" id="var_initial_stake" variabletype="">Initial_Stake</field></block></value>
      <next><block type="variables_set" id="blk040">
       <field name="VAR" id="var_loss_count" variabletype="">Loss_Count</field>
       <value name="VALUE"><block type="math_number" id="blk039"><field name="NUM">0</field></block></value>
      </block></next>
     </block>
    </statement>
    <statement name="ELSE">
     <block type="math_change" id="blk042">
      <field name="VAR" id="var_loss_count" variabletype="">Loss_Count</field>
      <value name="DELTA"><block type="math_number" id="blk043"><field name="NUM">1</field></block></value>
      <next><block type="controls_if" id="blk055">
       <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"/>
       <value name="IF0"><block type="logic_compare" id="blk046">
        <field name="OP">GTE</field>
        <value name="A"><block type="variables_get" id="blk044"><field name="VAR" id="var_loss_count" variabletype="">Loss_Count</field></block></value>
        <value name="B"><block type="variables_get" id="blk045"><field name="VAR" id="var_max_steps" variabletype="">Max_Recovery_Steps</field></block></value>
       </block></value>
       <statement name="DO0">
        <block type="variables_set" id="blk050">
         <field name="VAR" id="var_current_stake" variabletype="">Current_Stake</field>
         <value name="VALUE"><block type="variables_get" id="blk047"><field name="VAR" id="var_initial_stake" variabletype="">Initial_Stake</field></block></value>
         <next><block type="variables_set" id="blk049">
          <field name="VAR" id="var_loss_count" variabletype="">Loss_Count</field>
          <value name="VALUE"><block type="math_number" id="blk048"><field name="NUM">0</field></block></value>
         </block></next>
        </block>
       </statement>
       <statement name="ELSE">
        <block type="variables_set" id="blk054">
         <field name="VAR" id="var_current_stake" variabletype="">Current_Stake</field>
         <value name="VALUE"><block type="math_arithmetic" id="blk053">
          <field name="OP">MULTIPLY</field>
          <value name="A"><block type="variables_get" id="blk051"><field name="VAR" id="var_current_stake" variabletype="">Current_Stake</field></block></value>
          <value name="B"><block type="variables_get" id="blk052"><field name="VAR" id="var_mart_mult" variabletype="">Martingale_Multiplier</field></block></value>
         </block></value>
        </block>
       </statement>
      </block></next>
     </block>
    </statement>
    <next><block type="controls_if" id="blk066">
     <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"/>
     <value name="IF0"><block type="logic_operation" id="blk064">
      <field name="OP">OR</field>
      <value name="A"><block type="logic_compare" id="blk058">
       <field name="OP">GTE</field>
       <value name="A"><block type="total_profit" id="blk056"/></value>
       <value name="B"><block type="variables_get" id="blk057"><field name="VAR" id="var_take_profit" variabletype="">Take_Profit</field></block></value>
      </block></value>
      <value name="B"><block type="logic_compare" id="blk063">
       <field name="OP">LTE</field>
       <value name="A"><block type="total_profit" id="blk059"/></value>
       <value name="B"><block type="math_arithmetic" id="blk062">
        <field name="OP">MULTIPLY</field>
        <value name="A"><block type="variables_get" id="blk060"><field name="VAR" id="var_stop_loss" variabletype="">Stop_Loss</field></block></value>
        <value name="B"><block type="math_number" id="blk061"><field name="NUM">-1</field></block></value>
       </block></value>
      </block></value>
     </block></value>
     <statement name="ELSE"><block type="trade_again" id="blk065"/></statement>
    </block></next>
   </block>
  </statement>
 </block>
</xml>